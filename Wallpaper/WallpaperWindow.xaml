<Window x:Class="MusicVisualizer.Wallpaper.WallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viz="clr-namespace:MusicVisualizer.Visualizer"
        xmlns:controls="clr-namespace:MusicVisualizer.Controls"
        Title="Music Visualizer Wallpaper" Width="800" Height="600"
        WindowStartupLocation="Manual" Left="-20000" Top="-20000"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="#0B0B12">
    <Grid>
        <viz:VisualizerCanvas x:Name="Viz"/>
        <!-- Bottom-right keeps it clear of desktop icons, which start top-left. -->
        <!-- Position comes from the "Song title" setting (NowPlayingCard.Place). -->
        <controls:NowPlayingCard x:Name="Card" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,56,88"/>
        <!-- A copy of the normal desktop background, faded in before the window hides while nothing plays. -->
        <Grid x:Name="Desk" Opacity="0" IsHitTestVisible="False">
            <Image x:Name="DeskImage"/>
        </Grid>
    </Grid>
</Window>
