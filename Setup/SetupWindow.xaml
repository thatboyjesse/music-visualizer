<Window x:Class="MusicVisualizer.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Visualizer Setup" Width="640" Height="440"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico" Background="#12121A"
        BorderBrush="#2E2E44" BorderThickness="1" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (drag to move) -->
        <Grid x:Name="TitleBar" Background="#0E0E15" Height="36" MouseLeftButtonDown="OnTitleBarDrag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Image Source="pack://application:,,,/app.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="Music Visualizer Setup" FontSize="12" Opacity="0.7"/>
            </StackPanel>
            <Button x:Name="CloseBtn" HorizontalAlignment="Right" Width="46" Height="36" Margin="0" Padding="0"
                    Background="Transparent" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Click="OnCloseClick"/>
        </Grid>

        <!-- Left art panel + pages -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1F6B" Offset="0"/>
                        <GradientStop Color="#120F2A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas x:Name="Art" ClipToBounds="True"/>
            </Border>
            <Image x:Name="Logo" Width="88" Height="88" VerticalAlignment="Top" Margin="0,48,0,0"/>

            <!-- Page 1: options -->
            <Grid x:Name="OptionsPage" Grid.Column="1" Margin="32,26,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Heading" Text="Install Music Visualizer" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubHeading" Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="13"
                               Text="A live music visualizer that runs from your system tray and as your desktop wallpaper."/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <TextBlock Text="Install to" FontSize="12" Opacity="0.7" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,20">
                        <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Content="Change…" Padding="12,6" Click="OnBrowseClick"/>
                        <TextBox x:Name="DirBox"/>
                    </DockPanel>
                    <CheckBox x:Name="StartupBox" IsChecked="True" Content="Start with Windows (runs quietly in the system tray)"/>
                    <CheckBox x:Name="DesktopBox" Content="Add a desktop shortcut"/>
                    <CheckBox x:Name="LaunchBox" IsChecked="True" Content="Open Music Visualizer when setup finishes"/>
                </StackPanel>

                <DockPanel Grid.Row="2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" Click="OnCloseClick"/>
                        <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource Primary}" MinWidth="96" Click="OnInstallClick"/>
                    </StackPanel>
                    <TextBlock Text="For your Windows user only. No admin rights needed." Style="{StaticResource Hint}"
                               VerticalAlignment="Center" FontSize="11"/>
                </DockPanel>
            </Grid>

            <!-- Page 2: progress -->
            <StackPanel x:Name="ProgressPage" Grid.Column="1" Margin="32,0,28,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Installing…" FontSize="22" FontWeight="SemiBold"/>
                <ProgressBar x:Name="Progress" Maximum="1" Margin="0,22,0,10"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}"/>
            </StackPanel>

            <!-- Page 3: done / error -->
            <Grid x:Name="DonePage" Grid.Column="1" Margin="32,26,28,22" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Border x:Name="DoneBadge" Width="44" Height="44" CornerRadius="22" Background="#5B4BFF" HorizontalAlignment="Left">
                        <TextBlock x:Name="DoneGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DoneTitle" Text="Music Visualizer is installed" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <TextBlock x:Name="DoneText" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               Text="It runs in your system tray, at the bottom-right of the taskbar (it may be under the ^ arrow). Click the icon any time for settings, or right-click it to quit."/>
                </StackPanel>
                <Button x:Name="FinishBtn" Grid.Row="1" HorizontalAlignment="Right" Content="Finish" MinWidth="96"
                        Style="{StaticResource Primary}" Click="OnFinishClick"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
