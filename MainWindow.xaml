<Window x:Class="MusicVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viz="clr-namespace:MusicVisualizer.Visualizer"
        xmlns:controls="clr-namespace:MusicVisualizer.Controls"
        Title="Music Visualizer" Width="1180" Height="700" MinWidth="900" MinHeight="460"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#0B0B12" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown" Closed="OnClosed">
    <Grid>
        <viz:VisualizerCanvas x:Name="Viz"/>

        <controls:NowPlayingCard x:Name="Card" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"/>

        <StackPanel x:Name="Intro" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80">
            <TextBlock Text="Music Visualizer" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Play something in Spotify, open an audio file, or visualize what your PC is playing."
                       Opacity="0.7" FontSize="14" Margin="0,8,0,20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Open audio file" Click="OnOpenClick" Background="#5B4BFF" Padding="18,9"/>
                <Button Content="Visualize live audio" Click="OnIntroLoopbackClick" Padding="18,9"/>
            </StackPanel>
            <TextBlock Opacity="0.45" FontSize="12" Margin="0,24,0,0" HorizontalAlignment="Center"
                       Text="Space  play/pause    1–7  styles    F  fullscreen    W  wallpaper    S  screen    H  hide controls"/>
        </StackPanel>

        <StackPanel x:Name="WallpaperNotice" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" Margin="0,0,0,80">
            <TextBlock Text="Running as your desktop wallpaper" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Close or minimize this window to see it. It keeps running from the system tray."
                       Opacity="0.65" FontSize="13" Margin="0,8,0,16" HorizontalAlignment="Center"/>
            <Button Content="Stop wallpaper" Click="OnWallpaperClick" HorizontalAlignment="Center" Margin="0"/>
        </StackPanel>

        <Border x:Name="ControlBar" VerticalAlignment="Bottom" Margin="16" Padding="10,8"
                CornerRadius="10" Background="#D915151F">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open" Click="OnOpenClick"/>
                    <ToggleButton x:Name="LoopbackBtn" Content="Live audio" Click="OnLoopbackClick"
                                  ToolTip="Visualize what's playing on this PC: all apps, or the apps chosen in Settings"/>
                    <Button x:Name="PlayBtn" Click="OnPlayClick" FontFamily="Segoe MDL2 Assets"
                            Content="&#xE768;" Width="38" ToolTip="Play/pause file (Space)"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="ModeBtn" Click="OnModeClick" MinWidth="120" Margin="0,0,14,0"
                            ToolTip="Next visual style (keys 1–7 pick one directly)"/>
                    <Button x:Name="ScreenBtn" Content="Screen 1" Click="OnScreenClick" Visibility="Collapsed"/>
                    <ToggleButton x:Name="WallpaperBtn" Content="Wallpaper" Click="OnWallpaperClick"
                                  ToolTip="Run the visualizer behind your desktop icons (W)"/>
                    <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="38" Click="OnSettingsClick" Margin="0"
                            ToolTip="Settings"/>
                </StackPanel>

                <Grid VerticalAlignment="Center" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TrackName" Grid.ColumnSpan="3" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" Text="No audio loaded"/>
                    <TextBlock x:Name="PositionText" Grid.Row="1" Text="0:00" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" Width="44"/>
                    <Slider x:Name="Seek" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                            IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center"
                            ValueChanged="OnSeekChanged"
                            PreviewMouseLeftButtonDown="OnSeekMouseDown" PreviewMouseLeftButtonUp="OnSeekMouseUp"/>
                    <TextBlock x:Name="DurationText" Grid.Row="1" Grid.Column="2" Text="0:00" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" TextAlignment="Right" Width="44"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
