<UserControl x:Class="MusicVisualizer.Controls.NowPlayingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="TransportBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="#B315151F" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ArtBorder" Width="72" Height="72" CornerRadius="8" Background="#262636">
                <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Width="240">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" FontSize="13" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                <Grid x:Name="ProgressTrack" Height="3" Margin="0,8,0,0">
                    <Border Background="#33FFFFFF" CornerRadius="1.5"/>
                    <Border x:Name="ProgressFill" Background="#E8E8F0" CornerRadius="1.5"
                            HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <DockPanel Margin="0,6,0,0">
                    <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource TransportBtn}" Content="&#xE892;" Click="OnPrevious" ToolTip="Previous"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource TransportBtn}" Content="&#xE768;" Click="OnPlayPause" ToolTip="Play/pause"/>
                        <Button Style="{StaticResource TransportBtn}" Content="&#xE893;" Click="OnNext" ToolTip="Next"/>
                    </StackPanel>
                    <TextBlock x:Name="SourceText" FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
