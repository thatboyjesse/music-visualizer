<Window x:Class="MusicVisualizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viz="clr-namespace:MusicVisualizer.Visualizer"
        xmlns:controls="clr-namespace:MusicVisualizer.Controls"
        Title="Music Visualizer settings" Width="980" Height="720"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico" Background="#12121A">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Tab headers: flat text with an underline when selected. -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <ContentPresenter x:Name="Text" Margin="0,0,0,7" Opacity="0.55"/>
                            <Border x:Name="Line" Height="2" CornerRadius="1" Background="#5B4BFF" Visibility="Hidden"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="1"/>
                                <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left: preview and the main action ============ -->
        <Border Background="#0E0E15">
            <DockPanel Margin="24,22,24,20">
                <DockPanel DockPanel.Dock="Top">
                    <Image x:Name="Logo" Width="40" Height="40" Margin="0,0,12,0"/>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Top" FontSize="11" Opacity="0.45"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Music Visualizer" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Open visualizer window" Click="OnOpenVisualizer"/>
                    <Button Content="Stop" Click="OnQuit"
                            ToolTip="Turn off the wallpaper and close this window. Music Visualizer stays in the tray; right-click the tray icon to exit completely."/>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="PREVIEW" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                    <!-- A full-size copy of the wallpaper screen, scaled down, so the card and positions match exactly. -->
                    <Border x:Name="PreviewFrame" CornerRadius="8" BorderBrush="#2E2E44" BorderThickness="1" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="PreviewSurface" Background="#0B0B12">
                                <viz:VisualizerCanvas x:Name="Preview"/>
                                <controls:NowPlayingCard x:Name="PreviewCard"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Play some music to see it move. Changes apply to the wallpaper straight away."
                               Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                    <Button x:Name="RunBtn" Click="OnRunClick" Margin="0,20,0,0" Padding="16,13" FontSize="15" FontWeight="SemiBold"
                            Background="#5B4BFF" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="RunHint" Style="{StaticResource Hint}" Margin="0,8,0,0" TextAlignment="Center"/>

                    <StackPanel x:Name="ScreenRow" Margin="0,18,0,0">
                        <TextBlock Text="SCREEN" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                        <WrapPanel x:Name="ScreenButtons"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Right: tabs ============ -->
        <DockPanel Grid.Column="1" Margin="30,22,22,0">
            <StackPanel DockPanel.Dock="Top">
                <Border x:Name="Welcome" Background="#1F1B3D" CornerRadius="8" Padding="16,12" Margin="0,0,8,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Welcome! Music Visualizer is your live wallpaper." FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85" FontSize="13"
                                   Text="Make it yours here, then click Run as wallpaper. It keeps running in the system tray (bottom-right of the taskbar, maybe under the ^ arrow); click the icon to come back."/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabLook" Style="{StaticResource Tab}" GroupName="Tabs" Content="Appearance" IsChecked="True" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabAudio" Style="{StaticResource Tab}" GroupName="Tabs" Content="Audio" Checked="OnTabChecked"/>
                    <RadioButton x:Name="TabGeneral" Style="{StaticResource Tab}" GroupName="Tabs" Content="General" Checked="OnTabChecked"/>
                </StackPanel>
                <Border Height="1" Background="#24243A" Margin="0,0,8,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid Margin="0,0,0,24">

                    <!-- Appearance tab -->
                    <StackPanel x:Name="LookPage">
                        <TextBlock Text="LOOK" Style="{StaticResource Section}"/>
                        <!-- Style buttons are created in code, one per VisualMode. -->
                        <WrapPanel x:Name="ModeButtons"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Each style remembers its own settings below. Frame rate, the background picture and the song title card are shared by all styles."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox x:Name="PeaksBox" Content="Peak caps" Margin="0,0,24,8" Checked="OnLookChanged" Unchecked="OnLookChanged"/>
                            <CheckBox x:Name="ReflectionBox" Content="Reflection" Checked="OnLookChanged" Unchecked="OnLookChanged"/>
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Number of bars" Style="{StaticResource Label}"/>
                            <Slider x:Name="BarCountSlider" Grid.Column="1" Minimum="16" Maximum="128" TickFrequency="8" IsSnapToTickEnabled="True"
                                    ValueChanged="OnSliderChanged" ToolTip="Fewer bars look bolder and simpler"/>
                            <TextBlock x:Name="BarCountText" Grid.Column="2" Style="{StaticResource Label}" Opacity="0.7" TextAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Bar thickness" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <Slider x:Name="BarWidthSlider" Grid.Row="1" Grid.Column="1" Minimum="0.15" Maximum="1" Margin="0,8,0,0" ValueChanged="OnSliderChanged"/>
                        </Grid>

                        <TextBlock Text="CYCLE STYLES" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="CycleBox" Content="Switch between styles automatically" Checked="OnCycleChanged" Unchecked="OnCycleChanged"/>
                        <StackPanel x:Name="CycleOptions" Margin="0,6,0,0">
                            <TextBlock Text="Styles to use" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <!-- One check box per style, created in code. -->
                            <WrapPanel x:Name="CycleModeBoxes" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="CycleByTime" GroupName="CycleBy" Content="After some time" Checked="OnCycleChanged"/>
                                <RadioButton x:Name="CycleBySongs" GroupName="CycleBy" Content="After some songs" Checked="OnCycleChanged"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Change every" Style="{StaticResource Label}"/>
                                <Slider x:Name="CycleSlider" Grid.Column="1" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnCycleSliderChanged"/>
                                <TextBlock x:Name="CycleText" Grid.Column="2" Style="{StaticResource Label}" Opacity="0.7" TextAlignment="Right"/>
                            </Grid>
                            <CheckBox x:Name="CycleShuffleBox" Content="Random order" Margin="0,10,0,0" Checked="OnCycleChanged" Unchecked="OnCycleChanged"/>
                            <TextBlock x:Name="CycleHint" Style="{StaticResource Hint}"/>
                        </StackPanel>

                        <TextBlock Text="COLORS" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ColorArt" GroupName="Colors" Content="Song art colors" Checked="OnColorModeChecked"/>
                            <RadioButton x:Name="ColorRainbow" GroupName="Colors" Content="Rainbow" Checked="OnColorModeChecked"/>
                            <RadioButton x:Name="ColorCustom" GroupName="Colors" Content="My colors" Checked="OnColorModeChecked"/>
                        </StackPanel>
                        <TextBlock x:Name="ColorHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="CustomColors" Margin="0,12,0,0">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="From" Style="{StaticResource Label}" Width="50"/>
                                <Border x:Name="Color1Swatch" Width="26" Height="26" CornerRadius="5" Margin="0,0,10,0" BorderBrush="#4A4A64" BorderThickness="1"/>
                                <TextBox x:Name="Color1Box" Width="84" Margin="0,0,12,0" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown"/>
                                <WrapPanel x:Name="Color1Presets" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="To" Style="{StaticResource Label}" Width="50"/>
                                <Border x:Name="Color2Swatch" Width="26" Height="26" CornerRadius="5" Margin="0,0,10,0" BorderBrush="#4A4A64" BorderThickness="1"/>
                                <TextBox x:Name="Color2Box" Width="84" Margin="0,0,12,0" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown"/>
                                <WrapPanel x:Name="Color2Presets" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="POSITION AND SIZE" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Left – right" Style="{StaticResource Label}"/>
                            <Slider x:Name="PosXSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="OnSliderChanged"/>
                            <TextBlock Grid.Row="1" Text="Up – down" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <Slider x:Name="PosYSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Margin="0,8,0,0" ValueChanged="OnSliderChanged"/>
                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" Minimum="0.3" Maximum="1.5" Margin="0,8,0,0" ValueChanged="OnSliderChanged"/>
                            <TextBlock Grid.Row="3" Text="Width" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                            <Slider x:Name="WidthSlider" Grid.Row="3" Grid.Column="1" Minimum="0.15" Maximum="1" Margin="0,8,0,0" ValueChanged="OnSliderChanged"
                                    ToolTip="How much of the screen's width it spans (not used by the round styles)"/>
                        </Grid>
                        <Button Content="Center it" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4" Click="OnCenterClick"/>

                        <TextBlock Text="SONG TITLE" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Where the album art, song and artist appear on the wallpaper."/>
                        <!-- Position buttons are created in code, one per TitlePosition. -->
                        <WrapPanel x:Name="TitleButtons"/>
                        <CheckBox x:Name="PeekBox" Margin="0,8,0,0" Checked="OnAlbumChanged" Unchecked="OnAlbumChanged"
                                  Content="When hidden, show it in the bottom right for a few seconds when a new song starts"/>

                        <TextBlock Text="ALBUM ART" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="AlbumBox" Content="Show the album cover in the middle" Checked="OnAlbumChanged" Unchecked="OnAlbumChanged"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="It stays in the center of the screen; the position sliders move only the visualizer. Radial and Ring size it to fit their circle. The other styles show it behind the visualizer, bouncing with the beat and the glow."/>
                        <!-- Shown only while the cover is on. -->
                        <StackPanel x:Name="AlbumOptions" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Cover size" Style="{StaticResource Label}"/>
                                <Slider x:Name="AlbumSizeSlider" Grid.Column="1" Minimum="0.12" Maximum="0.6" ValueChanged="OnSliderChanged"
                                        ToolTip="For the styles without a circle; Radial and Ring size it to fit the circle"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Bounce" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="1" Text="Still" Style="{StaticResource Label}" Opacity="0.6" Margin="0,0,10,0"/>
                                <Slider x:Name="AlbumBounceSlider" Grid.Column="2" Minimum="0" Maximum="3" ValueChanged="OnSliderChanged"
                                        ToolTip="How much the cover grows on the beat"/>
                                <TextBlock Grid.Column="3" Text="Big" Style="{StaticResource Label}" Opacity="0.6" Margin="10,0,0,0"/>
                                <TextBlock Grid.Row="1" Text="Bounce sharpness" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Soft" Style="{StaticResource Label}" Opacity="0.6" Margin="0,8,10,0"/>
                                <Slider x:Name="AlbumSharpnessSlider" Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="1" Margin="0,8,0,0" ValueChanged="OnSliderChanged"
                                        ToolTip="Soft: a smooth swell with the bass. Sharp: a quick kick on strong beats only."/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Sharp" Style="{StaticResource Label}" Opacity="0.6" Margin="10,8,0,0"/>
                            </Grid>
                            <TextBlock Text="Song and artist" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <!-- Caption position buttons are created in code (Below, Above, Left, Right, Hidden). -->
                            <WrapPanel x:Name="CaptionButtons" Margin="0,0,0,8"/>
                            <CheckBox x:Name="HideCardBox" Content="Hide the song title card (the cover already shows what's playing)" Checked="OnAlbumChanged" Unchecked="OnAlbumChanged"/>
                        </StackPanel>

                        <TextBlock Text="INTENSITY" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Calm" Style="{StaticResource Label}" Opacity="0.7"/>
                            <Slider x:Name="IntensitySlider" Grid.Column="1" Minimum="-2" Maximum="2" ValueChanged="OnSliderChanged"
                                    ToolTip="How strongly it reacts to the music"/>
                            <TextBlock Grid.Column="2" Text="Wild" Style="{StaticResource Label}" Opacity="0.7" Margin="12,0,0,0"/>
                        </Grid>

                        <TextBlock Text="SENSITIVITY BY FREQUENCY" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Make parts of the sound move the visualizer more (right) or less (left). Applies to the bar and spectrum styles."/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bass" Style="{StaticResource Label}"/>
                                <TextBlock Text="40–250 Hz" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Slider x:Name="EqBassSlider" Minimum="-12" Maximum="12" ValueChanged="OnSliderChanged"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="Kick drums, bass lines, 808s: the thump you feel."/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Text="Low mids" Style="{StaticResource Label}"/>
                                <TextBlock Text="250 Hz–2 kHz" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                <Slider x:Name="EqLowMidsSlider" Minimum="-12" Maximum="12" ValueChanged="OnSliderChanged"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="The body of vocals, guitars, piano and snare: where most melody lives."/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Text="High mids" Style="{StaticResource Label}"/>
                                <TextBlock Text="2–6 kHz" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                <Slider x:Name="EqHighMidsSlider" Minimum="-12" Maximum="12" ValueChanged="OnSliderChanged"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="Vocal clarity, snare crack, plucks and claps: the attack of each sound."/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <TextBlock Text="Treble" Style="{StaticResource Label}"/>
                                <TextBlock Text="6–16 kHz" Style="{StaticResource Hint}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                                <Slider x:Name="EqTrebleSlider" Minimum="-12" Maximum="12" ValueChanged="OnSliderChanged"/>
                                <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="Hi-hats, cymbals, shakers and breath: the sparkle and air."/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Even out" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,4" Click="OnResetEq"
                                ToolTip="Set all four back to the middle"/>

                        <TextBlock Text="BACKGROUND" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <CheckBox x:Name="GlowBox" Content="Glow" Margin="0" VerticalAlignment="Center" Checked="OnLookChanged" Unchecked="OnLookChanged"/>
                            <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0.1" Maximum="2" ValueChanged="OnSliderChanged"
                                    ToolTip="How bright the glow that pulses with the bass is"/>
                        </Grid>
                        <TextBlock Text="Picture behind the visualizer" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                        <WrapPanel>
                            <Button Content="Choose picture…" Click="OnChoosePicture" Margin="0,0,6,6"/>
                            <Button Content="Use my current wallpaper" Click="OnUseDesktopWallpaper" Margin="0,0,6,6"/>
                            <Button x:Name="RemovePictureBtn" Content="Remove" Click="OnRemovePicture" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <Grid x:Name="DimRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Darken picture" Style="{StaticResource Label}"/>
                            <Slider x:Name="DimSlider" Grid.Column="1" Minimum="0" Maximum="0.9" ValueChanged="OnSliderChanged"/>
                        </Grid>

                        <Button Content="Reset appearance" HorizontalAlignment="Left" Margin="0,26,0,0" Click="OnResetLook"/>
                    </StackPanel>

                    <!-- Audio tab -->
                    <StackPanel x:Name="AudioPage" Visibility="Collapsed">
                        <TextBlock Text="LISTEN TO" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ListenAll" GroupName="Listen" Content="Everything on this PC" Checked="OnListenChecked"/>
                            <RadioButton x:Name="ListenApps" GroupName="Listen" Content="Only the apps I choose" Checked="OnListenChecked"/>
                        </StackPanel>
                        <Border x:Name="AppsPanel" Background="#0B0B12" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,4" Margin="0" Click="OnRefreshApps"/>
                                    <TextBlock Text="Apps appear here once they've played sound. Tick the ones to visualize; apps you tick are picked up whenever they're running."
                                               Style="{StaticResource Hint}" Margin="0,0,12,0"/>
                                </DockPanel>
                                <StackPanel x:Name="AppList"/>
                                <TextBlock x:Name="AppsEmpty" Text="No apps are playing sound right now. Start some music, then click Refresh."
                                           Style="{StaticResource Hint}" Visibility="Collapsed"/>
                                <TextBlock x:Name="AppsError" Foreground="#FF8A80" TextWrapping="Wrap" FontSize="12"
                                           Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="WHEN NOTHING IS PLAYING" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="IdleBox" Content="Show my normal wallpaper until music plays again" Checked="OnIdleChanged" Unchecked="OnIdleChanged"/>
                        <Grid x:Name="IdleDelayRow">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <TextBlock Text="After it's quiet for" Style="{StaticResource Label}"/>
                            <Slider x:Name="IdleSlider" Grid.Column="1" Minimum="2" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnIdleSliderChanged"/>
                            <TextBlock x:Name="IdleText" Grid.Column="2" Style="{StaticResource Label}" Opacity="0.7" TextAlignment="Right"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Listens to whatever you chose above. When only certain apps are chosen, sounds from other apps don't count."/>
                    </StackPanel>

                    <!-- General tab -->
                    <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                        <TextBlock Text="STARTUP" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="StartupBox" Content="Start with Windows (in the system tray)" Checked="OnStartupClick" Unchecked="OnStartupClick"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="When it starts with Windows, the wallpaper comes back if it was on when you last used it."/>
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource Section}"/>
                        <TextBlock Text="Frame rate" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Fps" Content="15 fps" Tag="15" Checked="OnFpsChecked" x:Name="Fps15"/>
                            <RadioButton GroupName="Fps" Content="24 fps" Tag="24" Checked="OnFpsChecked" x:Name="Fps24"/>
                            <RadioButton GroupName="Fps" Content="30 fps" Tag="30" Checked="OnFpsChecked" x:Name="Fps30"/>
                            <RadioButton GroupName="Fps" Content="60 fps" Tag="60" Checked="OnFpsChecked" x:Name="Fps60"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,14"
                                   Text="Lower uses less CPU and battery. 30 looks smooth for a wallpaper; 60 is the smoothest and uses about twice the CPU."/>
                        <CheckBox x:Name="CoveredBox" Content="Pause while a maximized or full-screen window covers the wallpaper" Checked="OnCoveredChanged" Unchecked="OnCoveredChanged"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Nothing is drawn while you can't see it, so it uses almost no CPU while you work or game."/>

                        <TextBlock Text="ABOUT" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Settings are saved automatically. Start Music Visualizer from the Start menu to run the wallpaper, or Music Visualizer Settings to come here."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
