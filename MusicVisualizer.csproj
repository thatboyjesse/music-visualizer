<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 TFM gives access to WinRT APIs (system media session for Spotify now-playing). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the tray icon (NotifyIcon); its global usings are removed below
         so names like Application and MessageBox still mean the WPF ones. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MusicVisualizer</RootNamespace>
    <!-- The Rust engine is MusicVisualizer.exe; this app is the settings helper next to it (see App.xaml.cs). -->
    <AssemblyName>MusicVisualizerSettings</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>Music Visualizer</Product>

    <!-- Memory: the app runs all day in the background, so favour a small footprint over throughput.
         Non-concurrent GC skips the background GC thread and its extra memory; no dynamic PGO
         avoids instrumented copies of hot methods. ConserveMemory is set below. Measured on the
         wallpaper: about 143 MB private memory down to about 90 MB. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compact the GC heap more aggressively (0 = off, 9 = most). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- The installer is its own project (Setup\Setup.csproj); keep its files out of the app. -->
  <ItemGroup>
    <None Remove="native\**" />
    <Compile Remove="native\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Setup\**" />
    <Page Remove="Setup\**" />
    <ApplicationDefinition Remove="Setup\**" />
    <None Remove="Setup\**" />
    <EmbeddedResource Remove="Setup\**" />
  </ItemGroup>

</Project>
